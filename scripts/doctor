#!/usr/bin/env bash
# Vikhyath AI Engineering OS — Doctor Script
# Validates repository structure, portable manifest, marketplaces, and configuration integrity
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

VERSION_VAL=$(cat "$ROOT_DIR/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")

for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    echo "Vikhyath AI Engineering OS — Doctor"
    echo "Usage: ./scripts/doctor [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -v, --version  Show version"
    exit 0
  fi
  if [ "$arg" = "-v" ] || [ "$arg" = "--version" ]; then
    echo "vikhyath-ai-engineering-os v$VERSION_VAL"
    exit 0
  fi
done

PASS=0
FAIL=0
WARN=0

pass() { echo "  ✅ $1"; PASS=$((PASS + 1)); }
fail() { echo "  ❌ $1"; FAIL=$((FAIL + 1)); }
warn() { echo "  ⚠️  $1"; WARN=$((WARN + 1)); }

echo "🔍 Vikhyath AI Engineering OS — Doctor"
echo "======================================="
echo ""

# --- Repository Structure ---
echo "📁 Repository Structure"
for dir in skills agents workflows integrations config tests scripts .codex-plugin .claude-plugin .agents/skills .agents/plugins .github/workflows; do
  if [ -d "$ROOT_DIR/$dir" ]; then
    pass "$dir/ exists"
  else
    fail "$dir/ missing"
  fi
done
echo ""

# --- Portable Root Manifest (Agent Plugins 1.0.0) ---
echo "📦 Portable Root Manifest (Agent Plugins 1.0.0)"
ROOT_PLUGIN="$ROOT_DIR/plugin.json"
if [ -f "$ROOT_PLUGIN" ]; then
  if python3 -c "
import json, sys
data = json.load(open('$ROOT_PLUGIN'))
assert data.get('\$schema') == 'https://agent-plugins.org/schemas/1.0.0/plugin.schema.json', 'invalid \$schema'
assert data.get('name') == 'vikhyath-ai-engineering-os', 'invalid name'
assert 'version' in data, 'missing version'
assert 'description' in data, 'missing description'
assert 'author' in data, 'missing author'
assert 'license' in data, 'missing license'
forbidden = ['skills', 'mcpServers', 'interface', 'hooks', 'tools']
for f in forbidden:
    assert f not in data, f'Forbidden field {f} in portable root plugin.json'
print('OK')
" 2>/dev/null; then
    pass "plugin.json conforms to Agent Plugins 1.0.0 schema"
  else
    fail "plugin.json validation failed (invalid schema or forbidden top-level fields)"
  fi
else
  fail "plugin.json (root portable manifest) missing"
fi
echo ""

# --- Host Manifests & Marketplaces ---
echo "📋 Host Manifests & Marketplaces"

# Codex manifest
if [ -f "$ROOT_DIR/.codex-plugin/plugin.json" ]; then
  if python3 -c "import json; m = json.load(open('$ROOT_DIR/.codex-plugin/plugin.json')); assert 'mcpServers' not in m" 2>/dev/null; then
    pass ".codex-plugin/plugin.json valid JSON (no MCP)"
  else
    fail ".codex-plugin/plugin.json invalid or contains MCP"
  fi
else
  fail ".codex-plugin/plugin.json missing"
fi

# Claude manifest
if [ -f "$ROOT_DIR/.claude-plugin/plugin.json" ]; then
  if python3 -c "import json; m = json.load(open('$ROOT_DIR/.claude-plugin/plugin.json')); assert 'mcpServers' not in m; assert 'skills' not in m" 2>/dev/null; then
    pass ".claude-plugin/plugin.json valid minimal JSON"
  else
    fail ".claude-plugin/plugin.json invalid or contains non-standard fields"
  fi
else
  fail ".claude-plugin/plugin.json missing"
fi

# Codex Marketplace
if [ -f "$ROOT_DIR/.agents/plugins/marketplace.json" ]; then
  if python3 -c "
import json
m = json.load(open('$ROOT_DIR/.agents/plugins/marketplace.json'))
assert 'plugins' in m and len(m['plugins']) > 0
p = m['plugins'][0]
assert p['name'] == 'vikhyath-ai-engineering-os'
assert p['source'] == './'
" 2>/dev/null; then
    pass ".agents/plugins/marketplace.json valid"
  else
    fail ".agents/plugins/marketplace.json invalid"
  fi
else
  fail ".agents/plugins/marketplace.json missing"
fi

# Claude Marketplace
if [ -f "$ROOT_DIR/.claude-plugin/marketplace.json" ]; then
  if python3 -c "
import json
m = json.load(open('$ROOT_DIR/.claude-plugin/marketplace.json'))
assert 'plugins' in m and len(m['plugins']) > 0
p = m['plugins'][0]
assert p['name'] == 'vikhyath-ai-engineering-os'
assert p['source'] == './'
" 2>/dev/null; then
    pass ".claude-plugin/marketplace.json valid"
  else
    fail ".claude-plugin/marketplace.json invalid"
  fi
else
  fail ".claude-plugin/marketplace.json missing"
fi
echo ""

# --- Antigravity Packaging ---
echo "🌌 Antigravity Packaging"
if [ -f "$ROOT_DIR/.agents/skills/vikhyath-os/SKILL.md" ]; then
  if grep -q "name: vikhyath-os" "$ROOT_DIR/.agents/skills/vikhyath-os/SKILL.md"; then
    pass ".agents/skills/vikhyath-os/SKILL.md adapter intact"
  else
    fail ".agents/skills/vikhyath-os/SKILL.md missing name"
  fi
else
  fail ".agents/skills/vikhyath-os/SKILL.md missing"
fi
echo ""

# --- CI Workflow Integrity ---
echo "⚙️  CI Workflow Integrity"
if [ -f "$ROOT_DIR/.github/workflows/ci.yml" ]; then
  if python3 -c "
import yaml
ci = yaml.safe_load(open('$ROOT_DIR/.github/workflows/ci.yml'))
assert 'name' in ci
assert 'jobs' in ci
" 2>/dev/null; then
    pass ".github/workflows/ci.yml valid YAML workflow"
  else
    fail ".github/workflows/ci.yml invalid YAML"
  fi
else
  fail ".github/workflows/ci.yml missing"
fi
echo ""

# --- No MCP Check ---
echo "🚫 MCP Absence Check"
if grep -rq "mcpServers" "$ROOT_DIR/.codex-plugin/" "$ROOT_DIR/.claude-plugin/" "$ROOT_DIR/plugin.json" 2>/dev/null; then
  fail "MCP configuration found in plugin manifests!"
else
  pass "No MCP in plugin manifests"
fi
if [ -f "$ROOT_DIR/.mcp.json" ]; then
  fail ".mcp.json file exists — MCP is prohibited"
else
  pass "No .mcp.json file"
fi
if grep -rql "mcpServers\|mcp-configs\|mcp_server" "$ROOT_DIR/config/" 2>/dev/null; then
  fail "MCP references found in config/"
else
  pass "No MCP configuration in config/"
fi
echo ""

# --- YAML Configuration ---
echo "📄 YAML Configuration"
for file in config/capabilities.yaml config/routing.yaml config/priorities.yaml; do
  if [ -f "$ROOT_DIR/$file" ]; then
    if python3 -c "import yaml; yaml.safe_load(open('$ROOT_DIR/$file'))" 2>/dev/null; then
      pass "$file valid YAML"
    else
      fail "$file invalid YAML"
    fi
  else
    fail "$file missing"
  fi
done
echo ""

# --- Integration Files ---
echo "🔗 Integration Metadata"
for file in "$ROOT_DIR"/integrations/*.yaml; do
  if [ -f "$file" ]; then
    if python3 -c "import yaml; yaml.safe_load(open('$file'))" 2>/dev/null; then
      pass "$(basename "$file") valid YAML"
    else
      fail "$(basename "$file") invalid YAML"
    fi
  fi
done
echo ""

# --- Skills ---
echo "🎯 Skills"
for skill_dir in "$ROOT_DIR"/skills/vikhyath-*/; do
  skill_name=$(basename "$skill_dir")
  if [ -f "$skill_dir/SKILL.md" ]; then
    pass "$skill_name/SKILL.md exists"
  else
    fail "$skill_name/SKILL.md missing"
  fi
done
echo ""

# --- No Vendor Copies ---
echo "📦 No Upstream Copies"
if [ -d "$ROOT_DIR/vendor" ]; then
  fail "vendor/ directory exists — upstream copies prohibited"
else
  pass "No vendor/ directory"
fi
pass "No upstream repository copies detected"
echo ""

# --- Version Consistency ---
echo "🏷️  Version Consistency"
if [ -f "$ROOT_DIR/VERSION" ]; then
  VERSION=$(cat "$ROOT_DIR/VERSION" | tr -d '[:space:]')
  ROOT_VER=$(python3 -c "import json; print(json.load(open('$ROOT_PLUGIN')).get('version', ''))" 2>/dev/null || echo "")
  CODEX_VER=$(python3 -c "import json; print(json.load(open('$ROOT_DIR/.codex-plugin/plugin.json')).get('version', ''))" 2>/dev/null || echo "")
  CLAUDE_VER=$(python3 -c "import json; print(json.load(open('$ROOT_DIR/.claude-plugin/plugin.json')).get('version', ''))" 2>/dev/null || echo "")
  
  if [ "$VERSION" = "$ROOT_VER" ] && [ "$VERSION" = "$CODEX_VER" ] && [ "$VERSION" = "$CLAUDE_VER" ]; then
    pass "Version consistent across VERSION, plugin.json, and host manifests: $VERSION"
  else
    fail "Version mismatch: VERSION=$VERSION, root=$ROOT_VER, codex=$CODEX_VER, claude=$CLAUDE_VER"
  fi
else
  fail "VERSION file missing"
fi
echo ""

# --- Key Files ---
echo "📝 Key Files"
for file in README.md AGENTS.md CLAUDE.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md; do
  if [ -f "$ROOT_DIR/$file" ]; then
    pass "$file exists"
  else
    fail "$file missing"
  fi
done
echo ""

# --- Summary ---
echo "======================================="
echo "Results: ✅ $PASS passed, ❌ $FAIL failed, ⚠️  $WARN warnings"
if [ $FAIL -gt 0 ]; then
  echo "❌ Doctor found issues. Please fix the failures above."
  exit 1
else
  echo "✅ All doctor checks passed!"
  exit 0
fi
