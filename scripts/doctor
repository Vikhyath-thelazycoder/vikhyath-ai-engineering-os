#!/usr/bin/env bash
# Compatibility wrapper (v1.0.1 command preserved, spec §69): delegates to the Python core.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in -v|--version) set -- --version ;; *) set -- doctor "$@" ;; esac
exec env PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}" "${AGYLITE_PYTHON:-python3}" -m agylite "$@"
