#!/usr/bin/env bash
# Vikhyath AI Engineering OS — Validation Script
# Runs comprehensive validation tests with offline (default) and optional --online modes
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

ONLINE_MODE=false
for arg in "$@"; do
  if [ "$arg" = "--online" ]; then
    ONLINE_MODE=true
  fi
done

PASS=0
FAIL=0
warn() { echo "  ⚠️  $1"; }
pass() { echo "  ✅ $1"; PASS=$((PASS + 1)); }
fail() { echo "  ❌ $1"; FAIL=$((FAIL + 1)); }

echo "🧪 Vikhyath AI Engineering OS — Validation Suite"
echo "================================================="
if [ "$ONLINE_MODE" = true ]; then
  echo "🌐 Mode: ONLINE (verifying remote GitHub commit SHAs)"
else
  echo "📦 Mode: OFFLINE (structural and cryptographic format validation)"
fi
echo ""

# --- Portable Manifest Tests ---
echo "📦 Portable Manifest Tests"
ROOT_PLUGIN="$ROOT_DIR/plugin.json"
if python3 -c "
import json
data = json.load(open('$ROOT_PLUGIN'))
assert data.get('\$schema') == 'https://agent-plugins.org/schemas/1.0.0/plugin.schema.json'
assert data.get('name') == 'vikhyath-ai-engineering-os'
assert 'version' in data
assert 'mcpServers' not in data
assert 'skills' not in data
print('OK')
" 2>/dev/null; then
  pass "Root plugin.json adheres to Agent Plugins 1.0.0 specification"
else
  fail "Root plugin.json failed specification validation"
fi
echo ""

# --- Manifest Tests ---
echo "📋 Host Manifest Tests"

# Codex manifest
CODEX_MANIFEST="$ROOT_DIR/.codex-plugin/plugin.json"
if python3 -c "
import json
m = json.load(open('$CODEX_MANIFEST'))
assert 'name' in m
assert 'version' in m
assert 'skills' in m
assert 'mcpServers' not in m
assert m['name'] == 'vikhyath-ai-engineering-os'
print('OK')
" 2>/dev/null; then
  pass "Codex manifest valid, no MCP"
else
  fail "Codex manifest validation failed"
fi

# Claude manifest
CLAUDE_MANIFEST="$ROOT_DIR/.claude-plugin/plugin.json"
if python3 -c "
import json
m = json.load(open('$CLAUDE_MANIFEST'))
assert 'name' in m
assert 'mcpServers' not in m
assert 'skills' not in m
print('OK')
" 2>/dev/null; then
  pass "Claude manifest valid minimal JSON, no MCP"
else
  fail "Claude manifest validation failed"
fi

# Marketplaces
if python3 -c "
import json
m1 = json.load(open('$ROOT_DIR/.agents/plugins/marketplace.json'))
m2 = json.load(open('$ROOT_DIR/.claude-plugin/marketplace.json'))
assert m1['plugins'][0]['source'] == './'
assert m2['plugins'][0]['source'] == './'
print('OK')
" 2>/dev/null; then
  pass "Codex and Claude marketplace manifests valid"
else
  fail "Marketplace validation failed"
fi

# Antigravity files
if [ -f "$ROOT_DIR/.agents/skills/vikhyath-os/SKILL.md" ]; then
  pass "Antigravity skill adapter exists"
else
  fail "Antigravity skill adapter missing"
fi
echo ""

# --- Routing Tests ---
echo "🔀 Routing Tests"

if python3 -c "
import yaml
routing = yaml.safe_load(open('$ROOT_DIR/config/routing.yaml'))
r = routing['routing']

assert 'ecc' in r['simple-bugfix']['activate']
assert 'ecc' in r['complex-codebase']['activate']
assert 'graphify' in r['complex-codebase']['activate']
assert 'ecc' in r['security-task']['activate']
assert 'addy' in r['security-task']['activate']
assert 'ponytail' in r['simplicity-review']['activate']
assert 'ecc' in r['review-release']['activate']
assert 'gstack' in r['review-release']['activate']
assert 'ecc' in routing['fallback']['activate']
print('OK')
" 2>/dev/null; then
  pass "Routing rules valid"
  pass "  fix typo → minimal (ecc)"
  pass "  unfamiliar monorepo → ecc + graphify"
  pass "  authentication → ecc + addy"
  pass "  simplicity review → ponytail"
  pass "  production release → ecc + gstack"
else
  fail "Routing validation failed"
fi
echo ""

# --- Capability Registry Tests ---
echo "📦 Capability Registry Tests"

if python3 -c "
import yaml, re
caps = yaml.safe_load(open('$ROOT_DIR/config/capabilities.yaml'))['capabilities']

expected = ['ecc', 'graphify', 'unlazy', 'addy', 'agency', 'gstack', 'opendesign', 'ponytail', 'karpathy']
hex_sha_pattern = re.compile(r'^[0-9a-f]{40}$')

for cap in expected:
    assert cap in caps, f'missing capability: {cap}'
    assert 'source' in caps[cap], f'{cap} missing source'
    assert 'role' in caps[cap], f'{cap} missing role'
    assert 'priority' in caps[cap], f'{cap} missing priority'
    ref = caps[cap].get('ref', '')
    assert hex_sha_pattern.match(ref), f'{cap} ref is not a valid 40-character hexadecimal SHA: {ref}'
    assert 'activation' in caps[cap], f'{cap} missing activation'

assert caps['ecc']['priority'] > caps['graphify']['priority']
assert caps['graphify']['priority'] > caps['unlazy']['priority']
assert caps['ponytail'].get('default') == 'off'

print('OK')
" 2>/dev/null; then
  pass "All 9 capabilities registered with pinned 40-character hexadecimal SHAs"
  pass "Priority ordering correct"
  pass "Ponytail defaults to off"
else
  fail "Capability registry validation failed"
fi
echo ""

# --- Online Dependency Verification (if --online specified) ---
if [ "$ONLINE_MODE" = true ]; then
  echo "🌐 Online GitHub SHA Verification"
  if python3 -c "
import yaml, urllib.request, json, sys

caps = yaml.safe_load(open('$ROOT_DIR/config/capabilities.yaml'))['capabilities']
headers = {'User-Agent': 'Vikhyath-OS-Validator'}

for name, meta in caps.items():
    source = meta['source']
    ref = meta['ref']
    url = f'https://api.github.com/repos/{source}/commits/{ref}'
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.status == 200:
                print(f'  ✅ {source} @ {ref[:8]} verified online')
    except Exception as e:
        print(f'  ❌ {source} @ {ref[:8]} online check failed: {e}')
        sys.exit(1)
" 2>/dev/null; then
    pass "All 9 capabilities verified against remote GitHub repositories"
  else
    warn "Online verification failed or rate-limited. Offline structural tests remain valid."
  fi
  echo ""
fi

# --- Security Tests ---
echo "🔒 Security Tests"

if grep -rq "mcpServers" "$ROOT_DIR/.codex-plugin/" "$ROOT_DIR/.claude-plugin/" "$ROOT_DIR/plugin.json" 2>/dev/null; then
  fail "MCP found in manifests"
else
  pass "No MCP in manifests"
fi

if [ -f "$ROOT_DIR/.mcp.json" ]; then
  fail ".mcp.json exists"
else
  pass "No .mcp.json"
fi

if [ -d "$ROOT_DIR/vendor" ]; then
  fail "vendor/ directory exists"
else
  pass "No vendor/ copies"
fi
echo ""

# --- Integration Metadata Tests ---
echo "🔗 Integration Tests"
for file in "$ROOT_DIR"/integrations/*.yaml; do
  name=$(basename "$file" .yaml)
  if python3 -c "
import yaml, re
i = yaml.safe_load(open('$file'))
assert 'source' in i, 'missing source'
assert 'role' in i, 'missing role'
ref = i.get('ref', '')
assert re.match(r'^[0-9a-f]{40}$', ref), f'Invalid ref in {file}'
assert 'integration_type' in i, 'missing integration_type'
print('OK')
" 2>/dev/null; then
    pass "$name integration metadata valid with pinned SHA"
  else
    fail "$name integration metadata invalid"
  fi
done
echo ""

# --- Python Unit Tests ---
echo "🧪 Unit Test Discovery"
if python3 -m unittest discover -s "$ROOT_DIR/tests" -p "test_*.py" >/dev/null 2>&1; then
  pass "All Python unit tests passed"
else
  fail "Python unit test discovery failed"
fi
echo ""

# --- Summary ---
echo "================================================="
echo "Results: ✅ $PASS passed, ❌ $FAIL failed"
if [ $FAIL -gt 0 ]; then
  echo "❌ Validation failed. Fix the issues above."
  exit 1
else
  echo "✅ All validation tests passed!"
  exit 0
fi
