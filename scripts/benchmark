#!/usr/bin/env bash
# Compatibility wrapper (v1.0.1 command preserved, spec §69): delegates to the Python core.
# Output is now measured (finding B-1), not hard-coded.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in -v|--version) set -- --version ;; *) set -- benchmark "$@" ;; esac
exec env PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}" "${VIKHYATH_PYTHON:-python3}" -m vikhyath "$@"
